{
  "name": "warungpilot-api",
  "version": "0.1.0",
  "private": true,
  "description": "WarungPilot Cloud Run API: Gemini (Vertex AI) extraction of handwritten notes",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:fake": "cross-env GEMINI_FAKE=1 APP_KEY=dev-key tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
