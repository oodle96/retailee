rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /owners/{uid}/documents/{documentId}/original {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.size > 0
        && request.resource.size <= 6 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }
  }
}
