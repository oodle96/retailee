rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /owners/{uid}/backups/current {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function valid() {
        return request.resource.data.keys().hasAll(['state', 'revision', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['state', 'revision', 'updatedAt'])
          && request.resource.data.state is string
          && request.resource.data.state.size() <= 800000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
